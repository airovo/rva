# ---------------------------------------------------------------------------
# RVA — ignore rules
# ---------------------------------------------------------------------------

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.xcuserstate
.idea/
.vscode/

# Rust build output
/target/
**/target/

# Node
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
*.tsbuildinfo

# JS/TS adapter & example build output
adapters/*/dist/
adapters/web/src/pkg/
adapters/node/src/pkg/
wasm/pkg/
examples/*/dist/
examples/*/out/

# Generated conformance / corpus artifacts
conformance/cabi_dump
conformance/sizes.txt
corpus/cabi_dump
corpus/sizes.txt
corpus/fixtures/

# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
**/build/

# Kotlin / Gradle
.gradle/
local.properties

# Swift
.build/
*.xcframework/

# Local environment / secrets
.env
.env.local
.env.*.local
*.local

# Local scratch
out/
tmp/

# Local-only assets and documents (not committed)
rva-demo-assets/
rva-torture-corpus-assets/
concept-reference.png
RVA_Product_Requirements_Document_v1.1.docx
