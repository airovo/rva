# ---------------------------------------------------------------------------
# RVA — ignore rules
# ---------------------------------------------------------------------------

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.xcuserstate
.idea/
.vscode/

# Rust build output
/target/
**/target/

# Node
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
*.tsbuildinfo

# JS/TS adapter & example build output
adapters/*/dist/
adapters/web/src/pkg/
adapters/node/src/pkg/
wasm/pkg/
examples/*/dist/
examples/*/out/

# Generated conformance / corpus artifacts
conformance/cabi_dump
conformance/sizes.txt
corpus/cabi_dump
corpus/sizes.txt
corpus/fixtures/

# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
**/build/

# Kotlin / Gradle
.gradle/
local.properties

# Swift
.build/
# The React Native iOS binary is vendored locally (not committed); the Flutter
# package's RVAFFI.xcframework IS committed (it ships on pub.dev).
adapters/react-native/ios/*.xcframework/

# Local environment / secrets
.env
.env.local
.env.*.local
*.local

# Local scratch
out/
tmp/