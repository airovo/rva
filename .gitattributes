# Normalize line endings to LF in the repo.
* text=auto eol=lf

# Binary assets — never diff/merge as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.wasm binary
*.rva binary
*.rvap binary
*.zip binary

# Generated lockfiles — collapse in diffs.
Cargo.lock linguist-generated=true
package-lock.json linguist-generated=true
