{
  "name": "@airovo/rva-types",
  "version": "0.1.0",
  "description": "TypeScript definitions for the RVA scene model and resolved scene, generated from the Rust core.",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "cargo run -p rva-core --bin export_types -- src/generated",
    "build": "tsc -p .",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "homepage": "https://rva.airovo.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/airovo/rva.git",
    "directory": "adapters/types"
  },
  "bugs": {
    "url": "https://github.com/airovo/rva/issues"
  },
  "author": "Airovo Technologies",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "rva",
    "responsive",
    "visual-asset",
    "adaptive",
    "wasm",
    "image"
  ]
}
