{
  "name": "@rva/react-native",
  "version": "0.1.0",
  "description": "React Native adapter for RVA: renders the <rva-image> web component (WASM core) inside a WebView, with an optional native-module path over the shared C ABI.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "ios",
    "android",
    "RNRva.podspec",
    "react-native.config.js"
  ],
  "scripts": {
    "build": "tsc -p ."
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.70",
    "react-native-webview": ">=13"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "react-native": "^0.76.0",
    "react-native-webview": "^13.12.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
