{
  "format": "RVA",
  "formatVersion": "0.1-draft",
  "name": "Nexa Hero Demo",
  "description": "Manual multi-element RVA prototype asset.",
  "designSpace": {
    "width": 1920,
    "height": 1080
  },
  "resources": {
    "bgLandscape": "02_backgrounds/bg-landscape.png",
    "bgPortrait": "02_backgrounds/bg-portrait.png",
    "bgSquare": "02_backgrounds/bg-square.png",
    "subject": "01_elements/subject-person.png",
    "product": "01_elements/product-laptop.png",
    "logo": "03_vectors/logo.svg",
    "bubbles": "03_vectors/bubbles.svg",
    "dots": "03_vectors/dot-grid.svg",
    "cta": "01_elements/cta-button.png",
    "subjectMask": "04_masks/subject-mask.png",
    "productShadow": "04_masks/product-shadow.png"
  },
  "text": {
    "headline": {
      "value": "Create Without Limits",
      "fontFamily": "system-ui",
      "weight": 800,
      "minSize": 34,
      "preferredSize": 74,
      "maxSize": 92,
      "maxLines": 3
    },
    "subheadline": {
      "value": "Design. Build. Launch. All in one place.",
      "fontFamily": "system-ui",
      "weight": 500,
      "minSize": 16,
      "preferredSize": 28,
      "maxSize": 34,
      "maxLines": 2
    }
  },
  "elements": [
    {
      "id": "background",
      "type": "raster",
      "role": "background",
      "priority": 100,
      "cropPolicy": "cover"
    },
    {
      "id": "dots",
      "type": "vector",
      "role": "decoration",
      "priority": 20,
      "visibility": "optional"
    },
    {
      "id": "bubbles",
      "type": "vector",
      "role": "decoration",
      "priority": 30,
      "visibility": "optional"
    },
    {
      "id": "logo",
      "type": "vector",
      "role": "logo",
      "priority": 95,
      "cropPolicy": "none"
    },
    {
      "id": "subject",
      "type": "raster",
      "role": "primary-subject",
      "priority": 100,
      "cropPolicy": "protected",
      "mask": "subjectMask",
      "focalRegions": [
        {
          "name": "face",
          "x": 0.34,
          "y": 0.1,
          "w": 0.36,
          "h": 0.34,
          "hard": true
        }
      ]
    },
    {
      "id": "product",
      "type": "raster",
      "role": "product",
      "priority": 85,
      "cropPolicy": "none"
    },
    {
      "id": "headline",
      "type": "text",
      "role": "headline",
      "priority": 100
    },
    {
      "id": "subheadline",
      "type": "text",
      "role": "subheadline",
      "priority": 80
    },
    {
      "id": "cta",
      "type": "raster",
      "role": "cta-visual",
      "priority": 70
    }
  ],
  "topologies": [
    {
      "id": "landscape",
      "when": {
        "minAspectRatio": 1.35
      },
      "background": "bgLandscape",
      "layout": {
